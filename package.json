{
  "name": "pro-locksmith-tech",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --config vite.ssr.config.ts --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "prebuild": "node scripts/generate-navigation.mjs && node scripts/optimize-service-images.mjs",
    "predev": "node scripts/generate-navigation.mjs && node scripts/optimize-service-images.mjs",
    "prelint": "node scripts/generate-navigation.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "parse5": "8.1.1",
    "playwright": "1.65.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
